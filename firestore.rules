rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-game play stats (e.g. how many times a game was played).
    // No login yet, so reads/writes are open on this collection only.
    // Tighten this once Firebase Authentication is added.
    match /gameStats/{gameId} {
      allow read, write: if true;
    }

    // Everything else is locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
